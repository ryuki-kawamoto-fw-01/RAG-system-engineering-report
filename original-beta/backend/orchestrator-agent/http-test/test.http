Content-Type: application/json

{
  "question": "手順計画に関連する規格をTTSとJKSから検索して下さい。",
  "model": "gpt-5.2",
  "task": "specification",
  "chatHistory": [],
  "searchMethod": "semantic-hybrid-search"
}

### tool_use
POST http://localhost:7071/api/tool-use
Content-Type: application/json

{
    "task": "rag",
    "tool_calls": [
         {
        "function": {
          "arguments": "{\"query\": \"手順計画に関連する規格 TTS JKS\", \"desc\": \"手順計画に関連する規格について、TTSとJKSを含むセマンティック検索を行います。検索クエリは「手順計画に関連する規格 TTS JKS」です。\"}",
          "name": "semantic_search"
        }
         }
    ]
}

