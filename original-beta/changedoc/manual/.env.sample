AZURE_CONTENT_UNDERSTANDING_API_VERSION="2025-05-01-preview"
AZURE_CONTENT_UNDERSTANDING_ENDPOINT="" # "https://<your-custom-endpoint>.services.ai.azure.com/"
AZURE_CONTENT_UNDERSTANDING_ANALYZER_ID="" # analyzer-for-create-guideline-v3.1 (analyzerは、modules/content_understanding_module/analyzer_schema.jsonを参考に自動生成するため、任意の名称で構いません)
AZURE_CONTENT_UNDERSTANDING_SUBSCRIPTION_KEY="" # <your-subscription-key>
AZURE_COMPUTER_VISION_ENDPOINT="" # "https://<your-custom-endpoint>.cognitiveservices.azure.com/"
AZURE_COMPUTER_VISION_SUBSCRIPTION_KEY="" # <your-subscription-key>
AZURE_OPENAI_MODEL_NAME="gpt-4.1"
AZURE_OPENAI_API_VERSION="2025-04-01-preview"
AZURE_OPENAI_API_KEY="" # <your-api-key>
AZURE_OPENAI_ENDPOINT="" # "https://<your-custom-endpoint>.openai.azure.com"
# ユーザー委任SASを使用する場合は AZURE_STORAGE_CONNECTION_STRING を空にして AZURE_STORAGE_ACCOUNT_URL を設定
# AZURE_STORAGE_ACCOUNT_URL="" # "https://<account>.blob.core.windows.net" ユーザー委任SAS用（Azure AD認証）
APPLICATIONINSIGHTS_CONNECTION_STRING="" # "InstrumentationKey=<your-instrumentation-key>;IngestionEndpoint=https://<your-region>.in.applicationinsights.azure.com/;LiveEndpoint=https://<your-region>.livediagnostics.monitor.azure.com/;ApplicationId=<your-application-id>"
SEMANTICKERNEL_EXPERIMENTAL_GENAI_ENABLE_OTEL_DIAGNOSTICS=true
SEMANTICKERNEL_EXPERIMENTAL_GENAI_ENABLE_OTEL_DIAGNOSTICS_SENSITIVE=true